generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  password String
  phone    String?

  role UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      Item[]
  bookings   Booking[]
  reviews    Review[]
  wishlists  Wishlist[]
}

model Category {
  id   String  @id @default(uuid())
  name String  @unique
  icon String?

  createdAt DateTime @default(now())

  items Item[]
}

model Item {
  id String @id @default(uuid())

  title       String
  description String

  dailyRate Float
  deposit   Float

  imageUrl String?

  available Boolean @default(true)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bookings  Booking[]
  reviews   Review[]
  wishlists Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([categoryId])
}

model Booking {
  id String @id @default(uuid())

  startDate    DateTime
  endDate      DateTime
  numberOfDays Int
  totalPrice   Float

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  renterId String
  renter   User   @relation(fields: [renterId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([renterId])
  @@index([status])
}

model Review {
  id String @id @default(uuid())

  rating  Int
  comment String

  userId String
  user   User   @relation(fields: [userId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([itemId])
}

model Wishlist {
  id String @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}